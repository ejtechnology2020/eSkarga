# Skopiuj do infra/docker/.env (plik .env jest w .gitignore). Wartości tylko dla środowiska dev.
OPERATON_VERSION=2.2.0

POSTGRES_DB=eskarga
POSTGRES_USER=postgres
POSTGRES_PASSWORD=zmien-mnie-postgres
DB_USER_APP=eskarga_app
DB_PASSWORD_APP=zmien-mnie-app
DB_USER_MIGRATION=eskarga_migration
DB_PASSWORD_MIGRATION=zmien-mnie-migration

# Keycloak dev zgodny z kontraktem ID-users (realm id-users na :8180); sekrety klientów muszą zgadzać się z keycloak/id-users-realm.json (tylko dev)
ESKARGA_SECURITY_MODE=oidc
KEYCLOAK_ADMIN_PASSWORD=zmien-mnie-keycloak
OIDC_CLIENT_SECRET=dev-eskarga-secret
OIDC_WORKERS_SECRET=dev-workers-secret
OIDC_ROLES_CLAIM=resource_access.eskarga.roles
OIDC_MFA_CLAIM=acr
OIDC_MFA_VALUE=mfa,wysoki

S3_ACCESS_KEY=eskarga-dev
S3_SECRET_KEY=zmien-mnie-s3

OPENSEARCH_ADMIN_PASSWORD=Zmien-Mnie-OpenSearch1!

SOFTHSM_SO_PIN=1234
SOFTHSM_USER_PIN=5678

# Dane przykładowe: „dziś” w interfejsie (puste = zegar systemowy)
ESKARGA_DEMO_TODAY=2026-11-03
# Dopisane w partii 2 (migracje Flyway CLI, monitoring, HSM)
GRAFANA_ADMIN_PASSWORD=zmien-mnie-grafana   # tylko profil monitoring
ESKARGA_HSM_MODE=off   # pkcs11 po inicjalizacji SoftHSM2 (infra/docker/softhsm)
