# Skopiuj do infra/docker/.env (plik .env jest w .gitignore). Wartości tylko dla środowiska dev.
OPERATON_VERSION=2.2.0
# SHA-256 pliku operaton-bpm-wildfly-${OPERATON_VERSION}.tar.gz (checksums_sha256.txt wydania na GitHubie)
OPERATON_SHA256=6bc09729936ccf735c6352fe2d0f89cf3ca89d4d1aee9ad973d4d909d4297a0e

POSTGRES_DB=eskarga
POSTGRES_USER=postgres
POSTGRES_PASSWORD=zmien-mnie-postgres
DB_USER_APP=eskarga_app
DB_PASSWORD_APP=zmien-mnie-app
DB_USER_MIGRATION=eskarga_migration
DB_PASSWORD_MIGRATION=zmien-mnie-migration

COMPOSE_PROJECT_NAME=eskarga

# Porty na hoście – przesunięte względem środowiska ID-users (projekt id: 8080, 9990, 8180, 9000, 5432, 8025, 1025, 1389, 1636, 8200)
PORT_APP=8082
PORT_APP_ADMIN=9992
PORT_DB=5433
PORT_S3=9100
PORT_S3_CONSOLE=9101
PORT_OPENSEARCH=9200
PORT_TSA=3180
PORT_WIREMOCK=8089
PORT_PROMETHEUS=9090
PORT_GRAFANA=3000
PORT_OIDC_LOCAL=8181
ESKARGA_PUBLIC_URL=http://localhost:8082/eskarga

# Logowanie przez Keycloak ID-users działający na hoście (dev/docker-compose.yml projektu id, realm id-users, :8180).
# Issuer: http://localhost:8180/realms/id-users; kontenery eSkargi dosięgają go przez host.docker.internal.
ESKARGA_SECURITY_MODE=oidc
OIDC_PROVIDER_URI=http://host.docker.internal:8180/realms/id-users
# Adres Keycloaka ID-users dla rejestracji klientów (kcadm). Domyślnie przez hosta; jeśli nie odpowiada, podłącz się
# do sieci projektu id: OIDC_PROVIDER_URI_ADMIN=http://wildfly:8180 i uruchom rejestrację z --network id-users_default
#OIDC_PROVIDER_URI_ADMIN=http://host.docker.internal:8180
# Rejestracja klientów eskarga/eskarga-workers w ID-users (profil id-users): hasło administratora Keycloaka z dev/.env projektu id
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.2
# Własny Keycloak (profil oidc-local, port 8181) tylko gdy ID-users nie działa: OIDC_PROVIDER_URI=http://oidc:8180/realms/id-users
OIDC_CLIENT_SECRET=dev-eskarga-secret
OIDC_WORKERS_SECRET=dev-workers-secret
# Rejestracja eSkargi narzędziem projektu id (npm --prefix frontend run aplikacje:eskarga, T-037) ustawia klientom eskarga
# i eskarga-workers metodę private_key_jwt i zapisuje klucze prywatne w katalogu wyników (domyślnie frontend/narzedzia/wyniki/eskarga).
# Podaj ten katalog (ścieżka względem infra/docker albo bezwzględna); aplikacja i workery użyją kluczy zamiast sekretów.
ID_USERS_KLUCZE_DIR=../../../id/frontend/narzedzia/wyniki/eskarga
# auto: private_key_jwt gdy jest eskarga.key.pem, inaczej sekret; wymuszenie: jwt | secret
OIDC_CLIENT_AUTH=auto
OIDC_ROLES_CLAIM=resource_access.eskarga.roles
OIDC_MFA_CLAIM=acr
OIDC_MFA_VALUE=mfa,wysoki
# PKCE klienta eskarga w Keycloaku ID-users: S256 (kontrakt; polityka klientów realmu id-users wymusza je dla wszystkich klientów). Mechanizm Elytron OIDC wysyła PKCE (ADR 0002, wariant 2).
ESKARGA_PKCE=S256

# S3 dev: RustFS (zamiennik MinIO, ADR 0022) + amazon/aws-cli do założenia kubełka z Object Lock
RUSTFS_IMAGE=rustfs/rustfs:1.0.4
AWSCLI_IMAGE=amazon/aws-cli:2.39.4
S3_ACCESS_KEY=eskarga-dev
S3_SECRET_KEY=zmien-mnie-s3

OPENSEARCH_ADMIN_PASSWORD=Zmien-Mnie-OpenSearch1!

SOFTHSM_SO_PIN=1234
SOFTHSM_USER_PIN=5678

# Dane przykładowe: „dziś” w interfejsie – tylko przy ESKARGA_SECURITY_MODE=demo (w trybie oidc zegar systemowy; puste = zegar systemowy)
ESKARGA_DEMO_TODAY=2026-11-03
# Dopisane w partii 2 (migracje Flyway CLI, monitoring, HSM)
GRAFANA_ADMIN_PASSWORD=zmien-mnie-grafana   # tylko profil monitoring
ESKARGA_HSM_MODE=off   # pkcs11 po inicjalizacji SoftHSM2 (infra/docker/softhsm)

# Podpis na dev (infra\windows\podpis.cmd wypełnia): magazyn zaufania usługi dokumentów z certyfikatem testowym sędziego i certyfikatem TSA dev
ESKARGA_DOCS_TRUSTSTORE=
ESKARGA_DOCS_TRUSTSTOREPASSWORD=

