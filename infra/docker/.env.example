# Skopiuj do infra/docker/.env (plik .env jest w .gitignore). Wartości tylko dla środowiska dev.
OPERATON_VERSION=2.2.0

POSTGRES_DB=eskarga
POSTGRES_USER=postgres
POSTGRES_PASSWORD=zmien-mnie-postgres
DB_USER_APP=eskarga_app
DB_PASSWORD_APP=zmien-mnie-app
DB_USER_MIGRATION=eskarga_migration
DB_PASSWORD_MIGRATION=zmien-mnie-migration

# Mock OIDC (ID-users) – nazwy claimów są konfigurowalne, bo kontrakt ID-users nie jest znany
ESKARGA_SECURITY_MODE=oidc
OIDC_CLIENT_SECRET=zmien-mnie-oidc
OIDC_ROLES_CLAIM=roles
OIDC_MFA_CLAIM=acr
OIDC_MFA_VALUE=mfa

S3_ACCESS_KEY=eskarga-dev
S3_SECRET_KEY=zmien-mnie-s3

OPENSEARCH_ADMIN_PASSWORD=Zmien-Mnie-OpenSearch1!

SOFTHSM_SO_PIN=1234
SOFTHSM_USER_PIN=5678

# Dane przykładowe: „dziś” w interfejsie (puste = zegar systemowy)
ESKARGA_DEMO_TODAY=2026-11-03
