{
  "request": {
    "method": "POST",
    "urlPath": "/edoreczenia/przesylki",
    "headers": {
      "Idempotency-Key": {
        "matches": ".+"
      }
    }
  },
  "response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "identyfikator": "EDO-{{request.headers.Idempotency-Key}}",
      "status": "PRZYJETA",
      "kluczIdempotencji": "{{request.headers.Idempotency-Key}}"
    },
    "transformers": [
      "response-template"
    ]
  }
}