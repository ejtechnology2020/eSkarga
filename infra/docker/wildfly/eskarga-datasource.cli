# Źródło danych aplikacji (T-003): jedna baza PostgreSQL, schematy repertorium (Flyway) i operaton (silnik, isAutoSchemaUpdate).
# Skrypt jest idempotentny – entrypoint uruchamia go przy każdym starcie kontenera.
# Wywołanie: jboss-cli.sh --file=eskarga-datasource.cli -Ddb.host=... -Ddb.name=... -Ddb.user=... -Ddb.password=...
# Nazwy zgodne z dystrybucją Operaton 2.2.0 (podsystem operaton-bpm-platform, silnik "default").
embed-server --server-config=standalone.xml --std-out=echo
if (outcome != success) of /subsystem=datasources/jdbc-driver=postgresql:read-resource
  /subsystem=datasources/jdbc-driver=postgresql:add(driver-name=postgresql, driver-module-name=org.postgresql, driver-xa-datasource-class-name=org.postgresql.xa.PGXADataSource)
end-if
if (outcome != success) of /subsystem=datasources/xa-data-source=EskargaDS:read-resource
  xa-data-source add --name=EskargaDS --jndi-name=java:jboss/datasources/EskargaDS --driver-name=postgresql \
    --user-name=${db.user} --password=${db.password} --use-ccm=true --min-pool-size=5 --max-pool-size=40 \
    --valid-connection-checker-class-name=org.jboss.jca.adapters.jdbc.extensions.postgres.PostgreSQLValidConnectionChecker \
    --xa-datasource-properties={"ServerName"=>"${db.host}","PortNumber"=>"5432","DatabaseName"=>"${db.name}","CurrentSchema"=>"operaton,repertorium"}
end-if
# search_path zaczyna się od operaton: skrypty DDL silnika (isAutoSchemaUpdate) nie kwalifikują tabel schematem, a rola aplikacji
# nie ma CREATE w repertorium („permission denied for schema repertorium”); JPA aplikacji ma hibernate.default_schema=repertorium.
if (result != "operaton,repertorium") of /subsystem=datasources/xa-data-source=EskargaDS/xa-datasource-properties=CurrentSchema:read-attribute(name=value)
  /subsystem=datasources/xa-data-source=EskargaDS/xa-datasource-properties=CurrentSchema:write-attribute(name=value, value="operaton,repertorium")
end-if
# Silnik Operaton na tym samym źródle danych (schemat operaton, tabele z prefiksem), historia audit, skrypty bez dostępu do hosta
# i zasobów zewnętrznych (D8). Atrybuty silnika w podsystemie są tylko do odczytu („WFLYCTL0048: Attribute datasource is not
# writable”), więc silnik "default" z dystrybucji jest usuwany i dodawany ponownie z kompletem ustawień (właściwości = mapa,
# wtyczki = lista; SubsystemAttributeDefinitons podsystemu 2.2.0). Wtyczki jak w standalone.xml dystrybucji.
if (result != "java:jboss/datasources/EskargaDS") of /subsystem=operaton-bpm-platform/process-engines=default:read-attribute(name=datasource)
  /subsystem=operaton-bpm-platform/process-engines=default:remove
  /subsystem=operaton-bpm-platform/process-engines=default:add(name=default, default=true, datasource=java:jboss/datasources/EskargaDS, history-level=audit, \
    properties={"jobExecutorAcquisitionName"=>"default", "isAutoSchemaUpdate"=>"true", "authorizationEnabled"=>"true", "jobExecutorDeploymentAware"=>"false", \
      "historyCleanupBatchWindowStartTime"=>"00:01", "databaseTablePrefix"=>"operaton.", "databaseSchema"=>"operaton", \
      "configureScriptEngineHostAccess"=>"false", "enableScriptEngineLoadExternalResources"=>"false"}, \
    plugins=[{"class"=>"org.operaton.bpm.application.impl.event.ProcessApplicationEventListenerPlugin"}, \
      {"class"=>"org.operaton.spin.plugin.impl.SpinProcessEnginePlugin"}, \
      {"class"=>"org.operaton.connect.plugin.impl.ConnectProcessEnginePlugin"}])
end-if

# Diagnostyka logowania ID-users w dev: przebieg mechanizmu Elytron OIDC (bez tokenów w logu na poziomie DEBUG)
if (outcome != success) of /subsystem=logging/logger=org.wildfly.security.http.oidc:read-resource
  /subsystem=logging/logger=org.wildfly.security.http.oidc:add(level=DEBUG)
end-if
stop-embedded-server
