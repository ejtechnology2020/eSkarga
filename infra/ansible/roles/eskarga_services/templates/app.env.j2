# generowane przez Ansible – sekrety z Vault, plik 0600
ESKARGA_ENVIRONMENT={{ eskarga_environment }}
ESKARGA_SECURITY_MODE=oidc
ESKARGA_OIDC_ISSUER={{ oidc_issuer | default('https://id-users.tk.internal/realms/tk') }}
ESKARGA_OIDC_CLIENTID=eskarga
ESKARGA_OIDC_CLIENTSECRET={{ vault_oidc_client_secret }}
ESKARGA_OIDC_ROLESCLAIM={{ oidc_roles_claim | default('roles') }}
ESKARGA_OIDC_MFACLAIM={{ oidc_mfa_claim | default('acr') }}
ESKARGA_OIDC_MFAREQUIREDVALUE={{ oidc_mfa_value | default('mfa') }}
ESKARGA_DOCS_URL=http://127.0.0.1:8080/eskarga-docs/api
ESKARGA_DOCS_OIDC_TOKENURL={{ oidc_token_url | default('https://id-users.tk.internal/realms/tk/protocol/openid-connect/token') }}
ESKARGA_DOCS_OIDC_CLIENTID=eskarga
ESKARGA_DOCS_OIDC_CLIENTSECRET={{ vault_oidc_client_secret }}
ESKARGA_SEARCH_URL=http://{{ groups['search'][0] }}:9200
ESKARGA_S3_ENDPOINT={{ s3_endpoint | default('https://s3.tk.internal') }}
ESKARGA_S3_BUCKET=eskarga-akta
ESKARGA_S3_ACCESSKEY={{ vault_s3_access_key }}
ESKARGA_S3_SECRETKEY={{ vault_s3_secret_key }}
ESKARGA_HSM_MODE=pkcs11
ESKARGA_HSM_PKCS11_CONFIG=/etc/eskarga/pkcs11.cfg
ESKARGA_HSM_PIN={{ vault_hsm_pin }}
ESKARGA_PDF_FONTDIR=/usr/share/fonts/truetype/liberation
ESKARGA_DOCS_TSAURL={{ tsa_url | default('') }}
ESKARGA_DOCS_CONVERTERURL={{ converter_url | default('http://127.0.0.1:3000') }}   # Gotenberg (rola konwerter_dokumentow, ADR 0026)
ESKARGA_DOCS_TSAUSER={{ tsa_user | default('') }}
ESKARGA_DOCS_TSAPASSWORD={{ vault_tsa_password | default('') }}
ESKARGA_DOCS_TSAKEYSTORE={{ tsa_keystore | default('') }}
ESKARGA_DOCS_TSAKEYSTOREPASSWORD={{ vault_tsa_keystore_password | default('') }}
ESKARGA_METRICS_ALLOW={{ metrics_allow | default('127.0.0.1') }}
DB_PASSWORD_APP={{ vault_db_password_app }}
