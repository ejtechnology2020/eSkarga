<?xml version="1.0" encoding="UTF-8"?>
<!-- Konfiguracja silnika do testów procesowych (operaton-bpm-junit5 + H2 w pamięci). -->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
  <bean id="processEngineConfiguration" class="org.operaton.bpm.engine.impl.cfg.StandaloneInMemProcessEngineConfiguration">
    <property name="jdbcUrl" value="jdbc:h2:mem:eskarga;DB_CLOSE_DELAY=1000" />
    <property name="jdbcDriver" value="org.h2.Driver" />
    <property name="jdbcUsername" value="sa" />
    <property name="jdbcPassword" value="" />
    <property name="databaseSchemaUpdate" value="true" />
    <property name="jobExecutorActivate" value="false" />
    <property name="history" value="full" />
    <property name="enforceHistoryTimeToLive" value="true" />
    <property name="beans">
      <map>
        <entry key="transferCompletedListener" value-ref="transferCompletedListener" />
      </map>
    </property>
  </bean>
  <bean id="transferCompletedListener" class="pl.ejtechnology.tk.eSkarga.process.RecordingTransferListener" />
</beans>
