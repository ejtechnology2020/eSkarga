<?xml version="1.0" encoding="UTF-8"?>
<!-- Process application (D9): modele BPMN/DMN wdrażane razem z WAR-em, nigdy ręcznie z Cockpitu. -->
<process-application xmlns="http://www.operaton.org/schema/1.0/ProcessApplication">
  <process-archive name="eskarga-wstepna-kontrola">
    <process-engine>default</process-engine>
    <properties>
      <property name="isDeleteUponUndeploy">false</property>
      <property name="isScanForProcessDefinitions">true</property>
      <property name="resourceRootPath">classpath:bpmn/</property>
      <property name="isDeployChangedOnly">true</property>
    </properties>
  </process-archive>
</process-application>
