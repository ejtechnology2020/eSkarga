<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
  <!-- Schemat „repertorium” w tej samej bazie co schemat „operaton”; jedno źródło danych XA w WildFly (D1, T-003).
       Schemat tworzy Flyway, nie JPA. -->
  <persistence-unit name="repertorium" transaction-type="JTA">
    <jta-data-source>java:jboss/datasources/EskargaDS</jta-data-source>
    <exclude-unlisted-classes>false</exclude-unlisted-classes>
    <properties>
      <property name="hibernate.default_schema" value="repertorium" />
      <property name="hibernate.hbm2ddl.auto" value="validate" />
      <property name="hibernate.jdbc.time_zone" value="UTC" />
    </properties>
  </persistence-unit>
</persistence>
