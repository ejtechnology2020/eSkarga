<?xml version="1.0" encoding="UTF-8"?>
<faces-config xmlns="https://jakarta.ee/xml/ns/jakartaee"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-facesconfig_4_1.xsd"
              version="4.1">
  <application>
    <locale-config>
      <default-locale>pl</default-locale>
      <supported-locale>pl</supported-locale>
    </locale-config>
    <resource-bundle>
      <base-name>pl.ejtechnology.tk.eSkarga.web.messages</base-name>
      <var>msg</var>
    </resource-bundle>
    <message-bundle>pl.ejtechnology.tk.eSkarga.web.messages</message-bundle>
    <!-- adresy własnych zasobów z parametrem v=<build> – po wdrożeniu przeglądarka nie używa plików JS/CSS z pamięci podręcznej (max-age 7 dni) -->
    <resource-handler>pl.ejtechnology.tk.eSkarga.web.faces.VersionedResourceHandler</resource-handler>
  </application>
</faces-config>
