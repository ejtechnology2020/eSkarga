<?xml version="1.0" encoding="UTF-8"?>
<!-- Aplikacja jako process application na współdzielonym silniku dystrybucji Operaton dla WildFly 41 (D9). -->
<jboss-deployment-structure xmlns="urn:jboss:deployment-structure:1.3">
  <deployment>
    <dependencies>
      <module name="org.operaton.bpm.operaton-engine" />
      <module name="org.operaton.bpm.dmn.operaton-engine-dmn" />
      <module name="org.operaton.bpm.model.operaton-bpmn-model" />
      <!-- OidcSecurityContext (tokeny logowania) z mechanizmu Elytron OIDC – ElytronTokens -->
      <module name="org.wildfly.security.elytron-http-oidc" />
      <!-- Apache HttpCore 5 (transport klienta OpenSearch) używa jdk.net.Sockets – pakiet JDK niewidoczny domyślnie dla wdrożeń
           (NoClassDefFoundError: jdk/net/Sockets w wątkach httpclient-dispatch) -->
      <system export="true">
        <paths>
          <path name="jdk/net" />
        </paths>
      </system>
    </dependencies>
    <exclusions>
      <!-- WAR niesie własny PrimeFaces; nie używamy modułów Jackson/Jakarta JSON-B z serwera w UI -->
    </exclusions>
  </deployment>
</jboss-deployment-structure>
