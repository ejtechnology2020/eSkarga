<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_1.xsd"
         version="6.1">
  <display-name>eSkarga – Repertorium Ts/Tw</display-name>

  <context-param>
    <param-name>jakarta.faces.PROJECT_STAGE</param-name>
    <param-value>${eskarga.faces.stage}</param-value>
  </context-param>
  <context-param>
    <param-name>jakarta.faces.FACELETS_SKIP_COMMENTS</param-name>
    <param-value>true</param-value>
  </context-param>
  <context-param>
    <param-name>jakarta.faces.INTERPRET_EMPTY_STRING_SUBMITTED_VALUES_AS_NULL</param-name>
    <param-value>true</param-value>
  </context-param>
  <context-param>
    <param-name>jakarta.faces.DATETIMECONVERTER_DEFAULT_TIMEZONE_IS_SYSTEM_TIMEZONE</param-name>
    <param-value>true</param-value>
  </context-param>
  <context-param>
    <param-name>jakarta.faces.WEBAPP_RESOURCES_DIRECTORY</param-name>
    <param-value>/resources</param-value>
  </context-param>

  <!-- PrimeFaces: motyw stonowany + tryb CSP (nonce dla skryptów, bez unsafe-eval) -->
  <context-param>
    <param-name>primefaces.THEME</param-name>
    <param-value>saga</param-value>
  </context-param>
  <context-param>
    <param-name>primefaces.CSP</param-name>
    <param-value>true</param-value>
  </context-param>
  <context-param>
    <param-name>primefaces.CSP_POLICY</param-name>
    <param-value>default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'</param-value>
  </context-param>
  <context-param>
    <param-name>primefaces.FONT_AWESOME</param-name>
    <param-value>false</param-value>
  </context-param>
  <context-param>
    <param-name>primefaces.MOVE_SCRIPTS_TO_BOTTOM</param-name>
    <param-value>true</param-value>
  </context-param>
  <context-param>
    <param-name>primefaces.UPLOADER</param-name>
    <param-value>native</param-value>
  </context-param>

  <!-- Filtry w ustalonej kolejności: nagłówki bezpieczeństwa → wybór roli demo → autoryzacja ekranu -->
  <filter>
    <filter-name>securityHeaders</filter-name>
    <filter-class>pl.ejtechnology.tk.eSkarga.security.SecurityHeadersFilter</filter-class>
  </filter>
  <filter>
    <filter-name>demoRole</filter-name>
    <filter-class>pl.ejtechnology.tk.eSkarga.security.DemoRoleFilter</filter-class>
  </filter>
  <filter>
    <filter-name>screenAccess</filter-name>
    <filter-class>pl.ejtechnology.tk.eSkarga.security.ScreenAccessFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>securityHeaders</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>demoRole</filter-name>
    <url-pattern>*.xhtml</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>screenAccess</filter-name>
    <url-pattern>*.xhtml</url-pattern>
  </filter-mapping>

  <servlet>
    <servlet-name>Faces Servlet</servlet-name>
    <servlet-class>jakarta.faces.webapp.FacesServlet</servlet-class>
    <load-on-startup>1</load-on-startup>
    <multipart-config>
      <!-- limity uploadu skanów: 50 MB na plik (NFR-13 / T-055) -->
      <max-file-size>52428800</max-file-size>
      <max-request-size>157286400</max-request-size>
      <file-size-threshold>1048576</file-size-threshold>
    </multipart-config>
  </servlet>
  <servlet-mapping>
    <servlet-name>Faces Servlet</servlet-name>
    <url-pattern>*.xhtml</url-pattern>
  </servlet-mapping>

  <welcome-file-list>
    <welcome-file>index.xhtml</welcome-file>
  </welcome-file-list>

  <session-config>
    <session-timeout>30</session-timeout>
    <cookie-config>
      <name>ESKARGA_SESSION</name>
      <http-only>true</http-only>
      <secure>true</secure>
      <!-- SameSite=Strict ustawia filtr nagłówków bezpieczeństwa (web.xml 6.1 nie ma atrybutu) -->
    </cookie-config>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>

  <!-- Strony błędów bez szczegółów technicznych (S-26) -->
  <error-page>
    <error-code>403</error-code>
    <location>/blad/403.xhtml</location>
  </error-page>
  <error-page>
    <error-code>404</error-code>
    <location>/blad/404.xhtml</location>
  </error-page>
  <error-page>
    <error-code>500</error-code>
    <location>/blad/500.xhtml</location>
  </error-page>
  <error-page>
    <exception-type>jakarta.faces.application.ViewExpiredException</exception-type>
    <location>/blad/sesja.xhtml</location>
  </error-page>
  <error-page>
    <exception-type>java.lang.Throwable</exception-type>
    <location>/blad/500.xhtml</location>
  </error-page>

  <!-- Zasoby WEB-INF i szablony nie są dostępne bezpośrednio -->
  <security-constraint>
    <display-name>Szablony i dołączenia</display-name>
    <web-resource-collection>
      <web-resource-name>templates</web-resource-name>
      <url-pattern>/WEB-INF/*</url-pattern>
    </web-resource-collection>
    <auth-constraint />
  </security-constraint>
</web-app>
