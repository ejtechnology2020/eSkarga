{
  "provider-url": "${env.ESKARGA_OIDC_PROVIDERURI:http://localhost:8180/realms/id-users}",
  "client-id": "${env.ESKARGA_OIDC_CLIENTID:eskarga}",
  "credentials": {
    "provider": "${env.ESKARGA_OIDC_CLIENTAUTH:secret}",
    "secret": "${env.ESKARGA_OIDC_CLIENTSECRET:nieustawiony}",
    "jwt-eskarga": {
      "private-key-pem": "${env.ESKARGA_OIDC_PRIVATEKEYPEM:/opt/eskarga/klucze/eskarga.key.pem}",
      "key-id": "${env.ESKARGA_OIDC_KEYID:}",
      "audience": "${env.ESKARGA_OIDC_ASSERTIONAUDIENCE:}"
    }
  },
  "public-client": false,
  "enable-pkce": true,
  "ssl-required": "${env.ESKARGA_OIDC_SSLREQUIRED:external}",
  "principal-attribute": "preferred_username",
  "use-resource-role-mappings": true,
  "scope": "profile email",
  "token-store": "SESSION",
  "logout-path": "/wyloguj",
  "post-logout-redirect-uri": "${env.ESKARGA_PUBLIC_URL:http://localhost:8082/eskarga}/"
}
