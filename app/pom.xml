<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>pl.ejtechnology.tk</groupId>
    <artifactId>eskarga-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>eskarga-app</artifactId>
  <packaging>war</packaging>
  <name>eSkarga – aplikacja (WAR)</name>
  <description>JSF + PrimeFaces, CDI/EJB, JPA, process application Operaton, modele BPMN/DMN.</description>

  <dependencies>
    <dependency>
      <groupId>pl.ejtechnology.tk</groupId>
      <artifactId>eskarga-common</artifactId>
    </dependency>
    <!-- Platforma dostarczana przez WildFly 41 -->
    <dependency>
      <groupId>jakarta.platform</groupId>
      <artifactId>jakarta.jakartaee-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Silnik procesów: współdzielony podsystem dystrybucji Operaton dla WildFly (D9) -->
    <dependency>
      <groupId>org.operaton.bpm</groupId>
      <artifactId>operaton-engine</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Integracja CDI pakowana w WAR (jak w dokumentacji Camunda 7 / Operaton dla WildFly) -->
    <dependency>
      <groupId>org.operaton.bpm</groupId>
      <artifactId>operaton-engine-cdi</artifactId>
      <exclusions>
        <exclusion>
          <!-- silnik dostarcza podsystem WildFly (scope provided powyżej) -->
          <groupId>org.operaton.bpm</groupId>
          <artifactId>operaton-engine</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- UI -->
    <dependency>
      <groupId>org.primefaces</groupId>
      <artifactId>primefaces</artifactId>
      <classifier>jakarta</classifier>
    </dependency>
    <dependency>
      <groupId>org.primefaces.extensions</groupId>
      <artifactId>primefaces-extensions</artifactId>
      <classifier>jakarta</classifier>
    </dependency>

    <!-- Baza: migracje schematu repertorium -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${postgresql.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Repozytorium dokumentów (API S3, bez zależności od dostawcy) -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
    </dependency>

    <!-- Wyszukiwanie (T-032): klient OpenSearch, transport Apache HttpClient 5 -->
    <dependency>
      <groupId>org.opensearch.client</groupId>
      <artifactId>opensearch-java</artifactId>
      <exclusions>
        <!-- API Jakarta dostarcza serwer (jakarta.jakartaee-api); stare javax.annotation 1.3.5 zasłaniało jakarta.annotation -->
        <exclusion><groupId>jakarta.annotation</groupId><artifactId>jakarta.annotation-api</artifactId></exclusion>
        <exclusion><groupId>jakarta.json.bind</groupId><artifactId>jakarta.json.bind-api</artifactId></exclusion>
        <exclusion><groupId>jakarta.json</groupId><artifactId>jakarta.json-api</artifactId></exclusion>
        <exclusion><groupId>org.eclipse</groupId><artifactId>yasson</artifactId></exclusion>
        <exclusion><groupId>org.glassfish</groupId><artifactId>jakarta.json</artifactId></exclusion>
        <exclusion><groupId>com.google.code.findbugs</groupId><artifactId>jsr305</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- Widżet PDF (T-034, ADR 0007) i edytor szablonów (T-026a) jako webjary serwowane przez JSF -->
    <dependency>
      <groupId>org.webjars.npm</groupId>
      <artifactId>pdfjs-dist</artifactId>
    </dependency>
    <dependency>
      <groupId>org.webjars.npm</groupId>
      <artifactId>codemirror</artifactId>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Testy -->
    <dependency>
      <!-- JPA w testach jednostkowych na H2 (ADR 0011); na WildFly dostawcę JPA daje serwer -->
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.operaton.bpm</groupId>
      <artifactId>operaton-bpm-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.operaton.bpm</groupId>
      <artifactId>operaton-bpm-assert</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- implementacja Jakarta JSON-P do testów API (w WildFly dostarcza ją serwer) -->
      <groupId>org.eclipse.parsson</groupId>
      <artifactId>parsson</artifactId>
      <version>1.1.7</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>eskarga</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <configuration>
          <failOnMissingWebXml>false</failOnMissingWebXml>
          <archive>
            <manifestEntries>
              <Implementation-Title>${project.name}</Implementation-Title>
              <Implementation-Version>${project.version}</Implementation-Version>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
