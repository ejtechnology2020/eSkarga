<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_TK_WstepnaKontrola" targetNamespace="http://trybunal.gov.pl/bpmn/wstepna-kontrola" exporter="Claude" exporterVersion="1.0">
  <bpmn:message id="Msg_Uzupelnienie" name="Pismo uzupełniające braki" />
  <bpmn:message id="Msg_Zazalenie" name="Zażalenie na odmowę nadania dalszego biegu" />
  <bpmn:collaboration id="Collab_TK">
    <bpmn:participant id="Part_TK" name="Trybunał Konstytucyjny – wstępna kontrola skarg (Ts) i wniosków (Tw)" processRef="Proc_WstepnaKontrola" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_WstepnaKontrola" name="Wstępna kontrola skargi konstytucyjnej / wniosku (art. 61 ustawy o TK)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_TK">
      <bpmn:lane id="Lane_Biuro" name="Biuro podawcze (Kancelaria TK)">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Wplyw</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Wydzial" name="Wydział Weryfikacyjny (BSP)">
        <bpmn:flowNodeRef>G_Typ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Ogolne</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Ogolne</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Wpis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Bieg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Przekaz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Przekaz</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sedzia" name="Sędzia TK">
        <bpmn:flowNodeRef>G_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Kontrola</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Wynik</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Braki</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Nadanie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Odmowa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EG_Braki</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Uzup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TM_Braki</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Powrot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EG_Zaz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Zaz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TM_Zaz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Odmowa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Prezes" name="Prezes TK lub osoba upoważniona">
        <bpmn:flowNodeRef>T_Wyznacz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Termin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Skieruj</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sklad" name="Skład 3 sędziów TK">
        <bpmn:flowNodeRef>T_BezRozp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_BezRozp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RozpZaz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Zasadne</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Nieuwzgl</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Pismo wpłynęło">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_Wplyw" name="Zarejestruj wpływ pisma">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Typ" name="Skarga lub wniosek?">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Ogolne" name="Zarejestruj pismo ogólne i udziel odpowiedzi">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_Ogolne" name="Pismo załatwione">
      <bpmn:incoming>F04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_Wpis" name="Wpisz sprawę do repertorium Ts / Tw">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Wyznacz" name="Wyznacz sędziego do wstępnej kontroli">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Merge">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Kontrola" name="Przeprowadź wstępną kontrolę">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Wynik" name="Wynik kontroli?">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Braki" name="Wydaj zarządzenie o usunięciu braków">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Nadanie" name="Wydaj postanowienie o nadaniu dalszego biegu">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F31</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Odmowa" name="Wydaj postanowienie o odmowie nadania biegu">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:eventBasedGateway id="EG_Braki">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="M_Uzup" name="Uzupełnienie wpłynęło">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="M_Uzup_Def" messageRef="Msg_Uzupelnienie" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="TM_Braki" name="Upłynęło 7 dni od doręczenia">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TM_Braki_Def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="G_Powrot">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="EG_Zaz">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="M_Zaz" name="Zażalenie wpłynęło">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
      <bpmn:messageEventDefinition id="M_Zaz_Def" messageRef="Msg_Zazalenie" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="TM_Zaz" name="Upłynęło 7 dni od doręczenia odmowy">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TM_Zaz_Def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="E_Odmowa" name="Odmowa prawomocna">
      <bpmn:incoming>F22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_Termin" name="Zażalenie w terminie?">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Skieruj" name="Skieruj zażalenie do składu i wyznacz posiedzenie">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_BezRozp" name="Pozostaw zażalenie bez rozpoznania">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_BezRozp" name="Zażalenie pozostawione bez rozpoznania">
      <bpmn:incoming>F26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_RozpZaz" name="Rozpoznaj zażalenie">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Zasadne" name="Zażalenie zasadne?">
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:outgoing>F29</bpmn:outgoing>
      <bpmn:outgoing>F30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_Nieuwzgl" name="Zażalenie nieuwzględnione">
      <bpmn:incoming>F29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_Bieg">
      <bpmn:incoming>F30</bpmn:incoming>
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Przekaz" name="Przekaż sprawę do repertorium SK / K / U">
      <bpmn:incoming>F32</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_Przekaz" name="Sprawa przekazana do rozpoznania merytorycznego">
      <bpmn:incoming>F33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start" targetRef="T_Wplyw" />
    <bpmn:sequenceFlow id="F02" sourceRef="T_Wplyw" targetRef="G_Typ" />
    <bpmn:sequenceFlow id="F03" name="nie (pismo ogólne)" sourceRef="G_Typ" targetRef="T_Ogolne" />
    <bpmn:sequenceFlow id="F04" sourceRef="T_Ogolne" targetRef="E_Ogolne" />
    <bpmn:sequenceFlow id="F05" name="tak" sourceRef="G_Typ" targetRef="T_Wpis" />
    <bpmn:sequenceFlow id="F06" sourceRef="T_Wpis" targetRef="T_Wyznacz" />
    <bpmn:sequenceFlow id="F07" sourceRef="T_Wyznacz" targetRef="G_Merge" />
    <bpmn:sequenceFlow id="F08" sourceRef="G_Merge" targetRef="T_Kontrola" />
    <bpmn:sequenceFlow id="F09" sourceRef="T_Kontrola" targetRef="G_Wynik" />
    <bpmn:sequenceFlow id="F10" name="braki usuwalne" sourceRef="G_Wynik" targetRef="T_Braki" />
    <bpmn:sequenceFlow id="F11" name="spełnia wymogi" sourceRef="G_Wynik" targetRef="T_Nadanie" />
    <bpmn:sequenceFlow id="F12" name="braki nieusuwalne, nieusunięte lub oczywista bezzasadność" sourceRef="G_Wynik" targetRef="T_Odmowa" />
    <bpmn:sequenceFlow id="F13" sourceRef="T_Braki" targetRef="EG_Braki" />
    <bpmn:sequenceFlow id="F14" sourceRef="EG_Braki" targetRef="M_Uzup" />
    <bpmn:sequenceFlow id="F15" sourceRef="EG_Braki" targetRef="TM_Braki" />
    <bpmn:sequenceFlow id="F16" sourceRef="M_Uzup" targetRef="G_Powrot" />
    <bpmn:sequenceFlow id="F17" sourceRef="TM_Braki" targetRef="G_Powrot" />
    <bpmn:sequenceFlow id="F18" sourceRef="G_Powrot" targetRef="G_Merge" />
    <bpmn:sequenceFlow id="F19" sourceRef="T_Odmowa" targetRef="EG_Zaz" />
    <bpmn:sequenceFlow id="F20" sourceRef="EG_Zaz" targetRef="M_Zaz" />
    <bpmn:sequenceFlow id="F21" sourceRef="EG_Zaz" targetRef="TM_Zaz" />
    <bpmn:sequenceFlow id="F22" sourceRef="TM_Zaz" targetRef="E_Odmowa" />
    <bpmn:sequenceFlow id="F23" sourceRef="M_Zaz" targetRef="G_Termin" />
    <bpmn:sequenceFlow id="F24" name="tak" sourceRef="G_Termin" targetRef="T_Skieruj" />
    <bpmn:sequenceFlow id="F25" name="nie" sourceRef="G_Termin" targetRef="T_BezRozp" />
    <bpmn:sequenceFlow id="F26" sourceRef="T_BezRozp" targetRef="E_BezRozp" />
    <bpmn:sequenceFlow id="F27" sourceRef="T_Skieruj" targetRef="T_RozpZaz" />
    <bpmn:sequenceFlow id="F28" sourceRef="T_RozpZaz" targetRef="G_Zasadne" />
    <bpmn:sequenceFlow id="F29" name="nie" sourceRef="G_Zasadne" targetRef="E_Nieuwzgl" />
    <bpmn:sequenceFlow id="F30" name="tak – nadanie dalszego biegu" sourceRef="G_Zasadne" targetRef="G_Bieg" />
    <bpmn:sequenceFlow id="F31" sourceRef="T_Nadanie" targetRef="G_Bieg" />
    <bpmn:sequenceFlow id="F32" sourceRef="G_Bieg" targetRef="T_Przekaz" />
    <bpmn:sequenceFlow id="F33" sourceRef="T_Przekaz" targetRef="E_Przekaz" />
  </bpmn:process>
